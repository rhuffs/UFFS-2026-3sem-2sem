# ============================================================
#  Constraints — Altera DE2 (Cyclone II EP2C20F484C7)
#  Quartus 13.0 ou superior
#  Projeto: Multiplicação FSM + Datapath
# ============================================================

set_global_assignment -name FAMILY "Cyclone II"
set_global_assignment -name DEVICE EP2C20F484C7
set_global_assignment -name TOP_LEVEL_ENTITY top_mult
set_global_assignment -name ORIGINAL_QUARTUS_VERSION "13.0"
set_global_assignment -name PROJECT_CREATION_TIME_DATE "00:00:00 JANUARY 01, 2024"
set_global_assignment -name LAST_QUARTUS_VERSION "13.0"

# ---- Arquivos fonte ----
set_global_assignment -name VERILOG_FILE debounce.v
set_global_assignment -name VERILOG_FILE register_file.v
set_global_assignment -name VERILOG_FILE ula.v
set_global_assignment -name VERILOG_FILE datapath.v
set_global_assignment -name VERILOG_FILE fsm_mult.v
set_global_assignment -name VERILOG_FILE bin2bcd_20.v
set_global_assignment -name VERILOG_FILE bcd_7seg.v
set_global_assignment -name VERILOG_FILE top_mult.v

# ============================================================
#  CLOCK
# ============================================================
set_location_assignment PIN_N2  -to CLOCK_50
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to CLOCK_50

# ============================================================
#  KEY (push-buttons, ativo-baixo)
# ============================================================
set_location_assignment PIN_G26 -to KEY[0]
set_location_assignment PIN_N23 -to KEY[1]
set_location_assignment PIN_P23 -to KEY[2]
set_location_assignment PIN_W26 -to KEY[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to KEY[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to KEY[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to KEY[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to KEY[3]

# ============================================================
#  SW (switches — 18 posições)
# ============================================================
set_location_assignment PIN_N25 -to SW[0]
set_location_assignment PIN_N26 -to SW[1]
set_location_assignment PIN_P25 -to SW[2]
set_location_assignment PIN_AE14 -to SW[3]
set_location_assignment PIN_AF14 -to SW[4]
set_location_assignment PIN_AD13 -to SW[5]
set_location_assignment PIN_AC13 -to SW[6]
set_location_assignment PIN_C13  -to SW[7]
